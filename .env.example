#
# Copy to .env.local for development, or set these in the hosting dashboard.
# Every value here is optional: the site builds and runs correctly with none of
# them set. Nothing in this file is a real credential.
#

# ---------------------------------------------------------------------------
# Required before going live
# ---------------------------------------------------------------------------

# Public origin, no trailing slash. Drives canonical URLs, hreflang, the
# sitemap, robots.txt and Open Graph URLs. Until this is set, all of those
# point at the placeholder https://autovacuum.am.
NEXT_PUBLIC_SITE_URL=https://autovacuum.am

# ---------------------------------------------------------------------------
# Map
# ---------------------------------------------------------------------------

# Which provider the location section embeds: google (default) or yandex.
# Both are click-to-load; neither is requested until a visitor asks for it.
NEXT_PUBLIC_MAP_PROVIDER=google

# ---------------------------------------------------------------------------
# Analytics — leave unset and no tracker is loaded at all
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Yandex Metrica counter number, digits only, e.g. 12345678
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Search engine verification — each meta tag appears only when its value is set
# ---------------------------------------------------------------------------

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ---------------------------------------------------------------------------
# Photo-assessment form
# ---------------------------------------------------------------------------

# Where /api/lead forwards submitted photos as multipart/form-data. Server-side
# only, never exposed to the browser. While this is empty the form renders in a
# read-only state that says so, and /api/lead answers 501. Set it to a real
# inbox endpoint (Formspree, Web3Forms, a Telegram bot relay, your own handler)
# before telling customers the form works.
LEAD_FORM_ENDPOINT=
